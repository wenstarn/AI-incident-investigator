FROM ghcr.io/astral-sh/uv:0.13.1 AS uv
FROM python:3.12-slim
ENV PATH="/app/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy
COPY --from=uv /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY services/user-service/pyproject.toml services/user-service/pyproject.toml
COPY services/order-service/pyproject.toml services/order-service/pyproject.toml
COPY services/shared/pyproject.toml services/shared/pyproject.toml
COPY services/diagnostic-tools services/diagnostic-tools
COPY tests/diagnostic_integration.py tests/diagnostic_integration.py
COPY tests/diagnostic_advanced_integration.py tests/diagnostic_advanced_integration.py
RUN uv sync --frozen --no-dev --no-editable --package diagnostic-tools
CMD ["python", "tests/diagnostic_integration.py"]
