POSTGRES_USER=app
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=shop
# Host processes use localhost; Compose services use Docker DNS.
DATABASE_URL=postgresql+psycopg://app:devpassword@localhost:5432/shop
COMPOSE_DATABASE_URL=postgresql+psycopg://app:devpassword@postgres:5432/shop
USER_SERVICE_DB_SCHEMA=user_service
ORDER_SERVICE_DB_SCHEMA=order_service
TEST_DATABASE_URL=postgresql+psycopg://app:devpassword@localhost:5432/shop
TEST_REDIS_URL=redis://localhost:6379/15
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=1.0
PRODUCT_CACHE_TTL_SECONDS=300
USER_SERVICE_URL=http://localhost:8001
USER_SERVICE_TIMEOUT_SECONDS=2.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SLOW_QUERY_THRESHOLD_MS=500
COMPOSE_PROJECT_NAME=ai-incident-investigator
INCIDENT_POSTGRES_RECOVERY_TIMEOUT_SECONDS=60
INCIDENT_HEALTH_REQUEST_TIMEOUT_SECONDS=2
INCIDENT_USER_DB_HEALTH_URL=http://user-service:8001/health/db
INCIDENT_ORDER_DB_HEALTH_URL=http://order-service:8002/health/db
FAULT_INJECTION_TOKEN=
INCIDENT_CONTROLLER_TOKEN=
DOCKER_EXECUTOR_TOKEN=
USER_SERVICE_INTERNAL_URL=http://user-service:8001
ORDER_SERVICE_INTERNAL_URL=http://order-service:8002
FAULT_INJECTION_TIMEOUT_SECONDS=2
# Defaults target unavailable ports inside the Compose network.
INCIDENT_BAD_USER_SERVICE_URL=http://user-service:9999
INCIDENT_BAD_REDIS_URL=redis://redis:9999/0

# Read-only diagnostics credentials are generated by make setup.
DOCKER_EXECUTOR_READ_TOKEN=
DIAGNOSTIC_POSTGRES_PASSWORD=
DIAGNOSTIC_POSTGRES_USER=diagnostic_reader
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
DOCKER_EXECUTOR_READ_URL=http://127.0.0.1:8005
DIAGNOSTIC_HTTP_TIMEOUT_SECONDS=5
DIAGNOSTIC_POSTGRES_TIMEOUT_SECONDS=3
DIAGNOSTIC_REDIS_TIMEOUT_SECONDS=3
DIAGNOSTIC_DOCKER_TIMEOUT_SECONDS=5

# Read-only Order Service dependency diagnostics (distinct from fault token).
DIAGNOSTICS_TOKEN=

# Investigator agent: any OpenAI-compatible chat completions API with tool
# calling (OpenAI, OpenRouter, Ollama, vLLM, LM Studio). For local Ollama keep
# LLM_API_KEY empty and set LLM_MODEL to a pulled model, e.g. qwen3.5:4b.
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1, LLM_API_KEY=<key from
# openrouter.ai/keys>, LLM_MODEL=deepseek/deepseek-v4.1-flash (any model whose
# supported parameters include tools).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
# Optional JSON merged into each request. For Ollama qwen3.x models
# {"reasoning_effort":"none"} disables slow "thinking" output.
LLM_EXTRA_BODY=
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_OUTPUT_CHARS=6000
MAS_MAX_REVIEW_ROUNDS=2
MAS_SPECIALIST_MAX_STEPS=6
# Used only by the live evaluation harness, never by the agents.
INCIDENT_CONTROLLER_URL=http://127.0.0.1:8003
