POSTGRES_USER=app
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=shop
# Host processes use localhost; Compose services use Docker DNS.
DATABASE_URL=postgresql+psycopg://app:devpassword@localhost:5432/shop
COMPOSE_DATABASE_URL=postgresql+psycopg://app:devpassword@postgres:5432/shop
USER_SERVICE_DB_SCHEMA=user_service
ORDER_SERVICE_DB_SCHEMA=order_service
TEST_DATABASE_URL=postgresql+psycopg://app:devpassword@localhost:5432/shop
TEST_REDIS_URL=redis://localhost:6379/15
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=1.0
PRODUCT_CACHE_TTL_SECONDS=300
USER_SERVICE_URL=http://localhost:8001
USER_SERVICE_TIMEOUT_SECONDS=2.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SLOW_QUERY_THRESHOLD_MS=500
COMPOSE_PROJECT_NAME=ai-incident-investigator
INCIDENT_POSTGRES_RECOVERY_TIMEOUT_SECONDS=60
INCIDENT_HEALTH_REQUEST_TIMEOUT_SECONDS=2
INCIDENT_USER_DB_HEALTH_URL=http://user-service:8001/health/db
INCIDENT_ORDER_DB_HEALTH_URL=http://order-service:8002/health/db
FAULT_INJECTION_TOKEN=5ba655d1a34f9607a9f033ca0f74ea9ff83f9097d07291f89792e85d12f57770
INCIDENT_CONTROLLER_TOKEN=98f3fdd1d50eb7ed1984191680974ee5401663bc66ccf4bde115e2c2dd28713f
