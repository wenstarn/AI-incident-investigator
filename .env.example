USER_SERVICE_INTERNAL_URL=http://user-service:8001
ORDER_SERVICE_INTERNAL_URL=http://order-service:8002
FAULT_INJECTION_TIMEOUT_SECONDS=2
# Defaults target unavailable ports inside the Compose network.
INCIDENT_BAD_USER_SERVICE_URL=http://user-service:9999
INCIDENT_BAD_REDIS_URL=redis://redis:9999/0

# Diagnostics: generate separate values for both credentials before Compose startup.
DOCKER_EXECUTOR_READ_TOKEN=
DIAGNOSTIC_POSTGRES_PASSWORD=
DIAGNOSTIC_POSTGRES_USER=diagnostic_reader
POSTGRES_HOST=127.0.0.1
